#!/bin/bash
# Run the default herdr server under launchd (macos/com.broots.herdr-server.plist, D-011).
#
# - ~/.config/herdr holds the API and client sockets (0600, set by herdr), session.json and
#   herdr's logs (0644 as herdr writes them). The directory goes to 0700 first, so no other
#   local account (gha-runner runs CI jobs on n0) can read those or reach the sockets.
# - A server someone started by hand (`herdr` in a terminal) owns the socket: wait for it to
#   stop instead of failing and being restarted every 10 s.
# - No umask change: pane shells inherit it, and agents' files must keep normal modes.
set -u

HERDR_BIN="${HERDR_BIN:-/opt/homebrew/bin/herdr}"
HERDR_DIR="${HERDR_DIR:-$HOME/.config/herdr}"
WAIT_S="${HERDR_SERVER_WAIT_S:-30}"

mkdir -p "$HERDR_DIR/sessions"
chmod 700 "$HERDR_DIR" "$HERDR_DIR/sessions"

running() {
  "$HERDR_BIN" status server 2>/dev/null | grep -q '^ *status: running'
}

while running; do
  sleep "$WAIT_S"
done

# Agent-detection rules come from the pinned binary only (D-012). Purged last, right before exec,
# so a cache refilled while we waited for a hand-started server is gone too. A remote cache can exist
# only if some herdr ran with manifest_check on (a session started before this config, or by
# hand): drop it so the server never loads rules nobody pinned.
STATE_DIR="${HERDR_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr}"
if [[ -d "$STATE_DIR/agent-detection/remote" ]]; then
  echo "$(date -u +%FT%TZ) herdr-server: removing the remote agent-detection cache (D-012)"
  rm -rf "$STATE_DIR/agent-detection/remote"
fi
# A failed check writes status.toml without remote/; left in place it failed the gate's
# "last check: never" test after every restart (code review 2026-11-08).
rm -f "$STATE_DIR/agent-detection/status.toml"

echo "$(date -u +%FT%TZ) herdr-server: starting $("$HERDR_BIN" --version 2>/dev/null)"
# `herdr --remote` offers to restart (and so end every pane of) a server that is not a session
# leader: upstream checks getsid(0) == getpid() (detached_server_daemon). A launchd job is a
# process-group leader and cannot call setsid itself, and macOS has no setsid command. So this
# process (the launchd job) forks: the child calls setsid and execs the server; the parent
# forwards TERM, INT, HUP and QUIT and exits with the server's status (D-017).
exec /usr/bin/perl -MPOSIX -e '
  my $pid = fork() // die "herdr-server: fork: $!\n";
  if ($pid == 0) { POSIX::setsid() >= 0 or die "herdr-server: setsid: $!\n"; exec @ARGV or die "herdr-server: exec: $!\n"; }
  for my $s (qw(TERM INT HUP QUIT)) { $SIG{$s} = sub { kill $s, $pid } }
  while (1) { my $w = waitpid($pid, 0); last if $w == $pid; exit 1 if $w == -1 && $!{ECHILD}; }
  exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
' "$HERDR_BIN" server

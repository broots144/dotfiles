#!/usr/bin/env bash
#
# Nightly copy of ~/dev into iCloud Drive: the off-site copy of what is not on GitHub
# (OpenTofu state, gitignored config, local branches, unpushed work).
#
# A copy, not a move: the repos stay live on local disk, so iCloud never syncs a working
# .git directory and Optimize Mac Storage never evicts a file a tool is using.
# Rebuildable directories and the two bulk folders (downloads, model weights) are skipped.
# --delete mirrors deletions; iCloud Drive keeps deleted files in Recently Deleted for 30 days.
#
# Not copied here on purpose: ~/.ssh and ~/.config/sops (private keys). Those come back from
# LastPass (age key) and Time Machine, never from a synced folder.
#
# Only age ciphertext carries anything that may hold a secret. Everything below is encrypted
# to the age public key in ~/.config/sops/age/keys.txt, whose private half is not in iCloud:
#   - dev-secrets.tar.age: files with a secret-bearing name (OpenTofu state and tfvars, .env,
#     OAuth tokens, private keys, kubeconfigs, agent local settings, ...), every gitignored
#     file up to 1 MiB, also inside gitignored directories (default-deny for secret names the
#     list misses; rebuildable output such as target/ is left out), and each repo's
#     .git/config. Gzipped inside the age stream (archives before 2026-11-06 are plain tar). Dated copies are kept in
#     secrets-history/. Nothing gitignored, of any size, is in the plaintext mirror.
#   - git/<repo>.bundle.age: every repo's history (all branches, tags, stash), rebuilt only
#     when its refs change. The plaintext mirror never holds a .git directory, because a
#     secret that was ever staged or committed lives on in the object store.
# Restore into a staging directory, then compare before copying anything back over ~/dev:
#   mkdir /tmp/restore && age -d -i ~/.config/sops/age/keys.txt dev-secrets.tar.age | tar -xzf - -C /tmp/restore
#     (drop the z for an archive from before 2026-11-06; macOS bsdtar detects either with -xf)
#   age -d -i ~/.config/sops/age/keys.txt git/<repo>.bundle.age > /tmp/r.bundle && git clone /tmp/r.bundle <dir>
#
# Run by macos/com.broots.dev-icloud-backup.plist; by hand: dev-icloud-backup [-n]
# Exit: 0 ok, 3 no age key, 4 secret archive failed, 5 a git bundle failed, 6 source implausible.

set -euo pipefail

src="$HOME/dev/"
icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
root="$icloud/Backups/$(scutil --get HostName 2>/dev/null || scutil --get LocalHostName 2>/dev/null || hostname -s)"
dst="$root/dev/"

if [[ ! -d "$icloud" ]]; then
  echo "$(date -u +%FT%TZ) iCloud Drive not found at $icloud; nothing copied" >&2
  exit 1
fi
mkdir -p "$dst"

dry=()
[[ "${1:-}" == "-n" ]] && dry=(-n)

start=$(date +%s)
status=0
# Writes into iCloud Drive can fail (EDEADLK on an evicted file, 2026-11-06), so the status
# record goes via a temp file and never stops the exit line from being logged.
finish() {
  if [[ ${#dry[@]} -eq 0 ]]; then
    { printf '{"finished_at":"%s","seconds":%d,"exit":%d,"source":"%s"}\n' \
        "$(date -u +%FT%TZ)" "$(( $(date +%s) - start ))" "$status" "$src" > "$root/.LAST_RUN.json.tmp" \
      && mv -f "$root/.LAST_RUN.json.tmp" "$root/LAST_RUN.json"; } \
      || echo "$(date -u +%FT%TZ) could not write $root/LAST_RUN.json" >&2
  fi
  echo "$(date -u +%FT%TZ) dev-icloud-backup exit=$status in $(( $(date +%s) - start ))s"
  exit "$status"
}

# An emptied or unmounted ~/dev must not be mirrored (with --delete) over a good backup.
# The probes tolerate a missing or unreadable directory (pipefail would end the run silently).
n_src=$( { find "$src" -mindepth 1 -maxdepth 1 2>/dev/null || true; } | wc -l | tr -d ' ')
n_dst=$( { find "$dst" -mindepth 1 -maxdepth 1 2>/dev/null || true; } | wc -l | tr -d ' ')
if (( n_src == 0 || n_src * 2 < n_dst )); then
  echo "$(date -u +%FT%TZ) $src has $n_src entries, mirror has $n_dst; refusing to mirror or archive" >&2
  status=6
  finish
fi

# What to skip, what is secret-bearing and what is gitignored: lib/dev-tree.sh, shared with
# bin/dev-sync-from-n0 so both copies of ~/dev carry the same set.
. "${ZSH:-$HOME/.dotfiles}/lib/dev-tree.sh"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
if ! dev_tree_lists "$src" "$work"; then
  echo "$(date -u +%FT%TZ) scan of $src failed; refusing to mirror or archive" >&2
  status=6
  finish
fi
args=("${DEV_TREE_RSYNC_EXCLUDES[@]}")
git_safe=("${DEV_TREE_GIT[@]}")

keys="$HOME/.config/sops/age/keys.txt"
cache="$HOME/.local/state/dev-icloud-backup/git"
recipient=$( { sed -n 's/^# public key: //p' "$keys" 2>/dev/null || true; } | head -1)
age=$(command -v age || echo /opt/homebrew/bin/age)
# The archive: tar of the listed files into age. Minutes pass between the scan and tar, and
# Night Shift writes under ~/dev meanwhile, so a listed file can be gone by then; bsdtar then
# exits 1 ("Cannot stat: No such file or directory") and the whole archive was discarded
# (review r3, N2). That case alone counts as success (the file is simply not in tonight's
# archive); any other tar error, or age failing, still fails. Sets `vanished`.
# DEV_BACKUP_TAR is for the tests.
tar_bin="${DEV_BACKUP_TAR:-tar}"
tar_archive() {  # <list> <out>
  local rc_t rc_a
  vanished=0
  "$tar_bin" --null -czf - -C "$src" -T "$1" 2>"$work/tar.err" | "$age" -r "$recipient" -o "$2"
  rc_t=${PIPESTATUS[0]} rc_a=${PIPESTATUS[1]}
  (( rc_a == 0 )) || return 1
  (( rc_t == 0 )) && return 0
  (( rc_t == 1 )) || { head -5 "$work/tar.err" >&2; return 1; }
  if grep -v -e ': Cannot stat: No such file or directory$' -e '^tar: Error exit delayed from previous errors\.$' "$work/tar.err" | grep -q .; then
    head -5 "$work/tar.err" >&2; return 1
  fi
  vanished=$(grep -c ': Cannot stat: No such file or directory$' "$work/tar.err" || true)
  return 0
}

if [[ ${#dry[@]} -gt 0 ]]; then
  :
elif [[ -z "$recipient" ]]; then
  echo "$(date -u +%FT%TZ) no age public key in $keys; secret files and git history not archived" >&2
  status=3
else
  # The encrypted archive first, so a file newly kept out of the mirror is never in neither copy.
  cat "$work/named" "$work/ignored" "$work/ignoredd" "$work/gitcfg" | sort -zu > "$work/list"
  n=$(tr -cd '\0' < "$work/list" | wc -c | tr -d ' ')
  tmp="$root/.dev-secrets.tar.age.tmp"; hist="$root/secrets-history"
  mkdir -p "$hist"
  if (( n == 0 )); then
    echo "$(date -u +%FT%TZ) no secret files found; keeping the previous archive" >&2
    status=4
  elif tar_archive "$work/list" "$tmp" \
      && mv -f "$tmp" "$root/dev-secrets.tar.age" \
      && cp -f "$root/dev-secrets.tar.age" "$hist/dev-secrets-$(date +%F).tar.age"; then
    gone=""; (( vanished == 0 )) || gone=", $vanished gone since the scan"
    echo "$(date -u +%FT%TZ) archived $n secret files (encrypted)$gone"
    # Keep two weeks of generations: one bad night must not leave only a bad archive.
    ls -1t "$hist"/dev-secrets-*.tar.age 2>/dev/null | tail -n +15 | while IFS= read -r old; do rm -f "$old"; done
  else
    rm -f "$tmp"
    echo "$(date -u +%FT%TZ) secret archive failed" >&2
    status=4
  fi

  # Git history as encrypted bundles, rebuilt only when a repo's refs changed. The refs cache
  # lives on local disk: an evicted .refs file in iCloud Drive failed to open (EDEADLK) and
  # ended the run. A repo with no local entry yet takes the old iCloud one once (copied here,
  # then removed from iCloud), so the move rebuilds nothing and iCloud .refs are not read again.
  mkdir -p "$root/git" "$cache"
  built=0
  while IFS= read -r -d '' g; do
    r="${g%/.git}"; name="${r//\//__}"
    refs=$("${git_safe[@]}" -C "$src$r" for-each-ref --format='%(objectname) %(refname)' 2>/dev/null || true)
    [[ -n "$refs" ]] || continue
    sum=$(printf '%s\n' "$refs" | shasum -a 256 | cut -d' ' -f1)
    refs_f="$cache/$name.refs"
    cached=$(cat "$refs_f" 2>/dev/null || true)
    if [[ -z "$cached" && -e "$root/git/$name.refs" ]]; then
      cached=$(cat "$root/git/$name.refs" 2>/dev/null || true)
      if [[ -n "$cached" ]] && printf '%s\n' "$cached" > "$refs_f.tmp" 2>/dev/null && mv -f "$refs_f.tmp" "$refs_f"; then
        rm -f "$root/git/$name.refs" 2>/dev/null || true
      fi
    fi
    [[ -f "$root/git/$name.bundle.age" && "$cached" == "$sum" ]] && continue
    if "${git_safe[@]}" -C "$src$r" bundle create -q "$work/b.bundle" --all 2>/dev/null \
        && "$age" -r "$recipient" -o "$root/git/.$name.tmp" "$work/b.bundle" \
        && mv -f "$root/git/.$name.tmp" "$root/git/$name.bundle.age"; then
      if printf '%s\n' "$sum" > "$refs_f.tmp" && mv -f "$refs_f.tmp" "$refs_f"; then
        rm -f "$root/git/$name.refs" 2>/dev/null || true
      else
        echo "$(date -u +%FT%TZ) could not record refs for $r" >&2
        [[ $status -eq 0 ]] && status=5
      fi
      built=$((built + 1))
    else
      rm -f "$root/git/.$name.tmp"
      echo "$(date -u +%FT%TZ) git bundle failed for $r" >&2
      [[ $status -eq 0 ]] && status=5
    fi
    rm -f "$work/b.bundle"
  done < "$work/repos"
  echo "$(date -u +%FT%TZ) rebuilt $built git bundle(s) (encrypted)"
fi

# --delete-excluded also removes .git directories and secret files an older run mirrored.
# -W: no delta transfer, so rsync never reads the mirror's copy of a changed file.
# Two iCloud Drive failures made openrsync give up (2026-11-07, exit 1, mirror left partial):
#   - "<dir>: unlinkat: Directory not empty": it cannot delete an excluded directory that iCloud
#     holds as a package (.app, .bundle, .xcodeproj under .build/); rm -rf can.
#   - "<file>: mmap: Resource deadlock avoided" (EDEADLK): the mirror's copy is evicted and
#     could not be read back; it is only a stale copy of a file in ~/dev, so it is removed.
# Each such path is fixed and rsync runs again, up to three times; then its status stands.
# DEV_BACKUP_RSYNC is for the tests.
rsync_bin="${DEV_BACKUP_RSYNC:-/usr/bin/rsync}"
icloud_fix() {  # <rsync stderr>: removes the mirror paths rsync choked on; false if none
  local p n=0
  while IFS= read -r p; do
    # Relative to the mirror, never above it.
    [[ -n "$p" && "$p" != /* && "$p" != .. && "$p" != ../* && "$p" != */.. && "$p" != */../* ]] || continue
    [[ -e "$dst$p" || -L "$dst$p" ]] || continue
    rm -rf -- "${dst:?}$p" && n=$((n + 1)) && echo "$(date -u +%FT%TZ) removed $p from the mirror (iCloud refused rsync)"
  done < <(sed -nE 's/^rsync(\([0-9]+\))?: error: (.*): (unlinkat: Directory not empty|(open|mmap|read|unlink|rename)[a-z]*: Resource deadlock avoided)$/\2/p' "$1")
  (( n > 0 ))
}
# An evicted mirror file (dataless, Optimize Mac Storage) that rsync would update has to be
# read back first, and that read is what fails with EDEADLK under launchd, one file per run
# (2026-11-07: 54k evicted files in the mirror). So before rsync, every evicted mirror file whose
# size or mtime differs from ~/dev (or that ~/dev no longer has) is removed: rsync then writes
# it fresh or has nothing to delete. Unchanged evicted files are left alone (rsync's quick check
# skips them without reading). DEV_BACKUP_EVICTED_FLAG is for the tests (a flag they can set).
evicted_flag="${DEV_BACKUP_EVICTED_FLAG:-dataless}"
icloud_drop_stale_evicted() {
  local n=0 p
  [[ -d "$dst" ]] || return 0
  { (cd "$dst" && find . -flags "+$evicted_flag" -type f -print0) || true; } > "$work/evicted"
  [[ -s "$work/evicted" ]] || return 0
  { (cd "$dst" && xargs -0 stat -f '%z %m %N' < "$work/evicted") || true; } > "$work/evicted.dst"
  { (cd "$src" && xargs -0 stat -f '%z %m %N' < "$work/evicted" 2>/dev/null) || true; } > "$work/evicted.src"
  while IFS= read -r p; do
    p="${p#* }"; p="${p#* }"; p="${p#./}"
    [[ -n "$p" && "$p" != *..* && -f "$dst$p" ]] || continue
    rm -f -- "${dst:?}$p" && n=$((n + 1))
  done < <(awk 'FILENAME == ARGV[1] { s[$0] = 1; next } !($0 in s)' "$work/evicted.src" "$work/evicted.dst")
  (( n == 0 )) || echo "$(date -u +%FT%TZ) removed $n evicted mirror file(s) that changed or went from ~/dev"
}
(( ${#dry[@]} )) || icloud_drop_stale_evicted
for attempt in 1 2 3; do
  rc=0
  "$rsync_bin" -a -W --delete --delete-excluded ${dry[@]+"${dry[@]}"} "${args[@]}" \
    --from0 --exclude-from="$work/rules" "$src" "$dst" 2>"$work/rsync.err" || rc=$?
  cat "$work/rsync.err" >&2
  (( rc != 0 && ${#dry[@]} == 0 && attempt < 3 )) || break
  icloud_fix "$work/rsync.err" || break
  echo "$(date -u +%FT%TZ) rsync exit $rc; retrying the mirror (attempt $((attempt + 1)) of 3)"
done
(( rc == 0 )) || { [[ $status -eq 0 ]] && status=$rc; }

finish

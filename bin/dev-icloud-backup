#!/usr/bin/env bash
#
# Nightly copy of ~/dev into iCloud Drive: the off-site copy of what is not on GitHub
# (OpenTofu state, gitignored config, local branches, unpushed work).
#
# A copy, not a move: the repos stay live on local disk, so iCloud never syncs a working
# .git directory and Optimize Mac Storage never evicts a file a tool is using.
# Rebuildable directories and the two bulk folders (downloads, model weights) are skipped.
# --delete mirrors deletions; iCloud Drive keeps deleted files in Recently Deleted for 30 days.
#
# Not copied here on purpose: ~/.ssh and ~/.config/sops (private keys). Those come back from
# LastPass (age key) and Time Machine, never from a synced folder.
#
# Only age ciphertext carries anything that may hold a secret. Everything below is encrypted
# to the age public key in ~/.config/sops/age/keys.txt, whose private half is not in iCloud:
#   - dev-secrets.tar.age: files with a secret-bearing name (OpenTofu state and tfvars, .env,
#     OAuth tokens, private keys, kubeconfigs, agent local settings, ...), every gitignored
#     file up to 1 MiB that sits outside an ignored directory (default-deny for secret names
#     the list misses), and each repo's .git/config. Dated copies are kept in secrets-history/.
#   - git/<repo>.bundle.age: every repo's history (all branches, tags, stash), rebuilt only
#     when its refs change. The plaintext mirror never holds a .git directory, because a
#     secret that was ever staged or committed lives on in the object store.
# Restore into a staging directory, then compare before copying anything back over ~/dev:
#   mkdir /tmp/restore && age -d -i ~/.config/sops/age/keys.txt dev-secrets.tar.age | tar -xf - -C /tmp/restore
#   age -d -i ~/.config/sops/age/keys.txt git/<repo>.bundle.age > /tmp/r.bundle && git clone /tmp/r.bundle <dir>
#
# Run by macos/com.broots.dev-icloud-backup.plist; by hand: dev-icloud-backup [-n]
# Exit: 0 ok, 3 no age key, 4 secret archive failed, 5 a git bundle failed, 6 source implausible.

set -euo pipefail

src="$HOME/dev/"
icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
root="$icloud/Backups/$(scutil --get LocalHostName 2>/dev/null || hostname -s)"
dst="$root/dev/"

if [[ ! -d "$icloud" ]]; then
  echo "$(date -u +%FT%TZ) iCloud Drive not found at $icloud; nothing copied" >&2
  exit 1
fi
mkdir -p "$dst"

dry=()
[[ "${1:-}" == "-n" ]] && dry=(-n)

start=$(date +%s)
status=0
finish() {
  if [[ ${#dry[@]} -eq 0 ]]; then
    printf '{"finished_at":"%s","seconds":%d,"exit":%d,"source":"%s"}\n' \
      "$(date -u +%FT%TZ)" "$(( $(date +%s) - start ))" "$status" "$src" > "$root/LAST_RUN.json"
  fi
  echo "$(date -u +%FT%TZ) dev-icloud-backup exit=$status in $(( $(date +%s) - start ))s"
  exit "$status"
}

# An emptied or unmounted ~/dev must not be mirrored (with --delete) over a good backup.
n_src=$(find "$src" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
n_dst=$(find "$dst" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' ')
if (( n_src == 0 || n_src * 2 < n_dst )); then
  echo "$(date -u +%FT%TZ) $src has $n_src entries, mirror has $n_dst; refusing to mirror or archive" >&2
  status=6
  finish
fi

# Folders to skip entirely (re-acquirable, tens of GB). '/x/' = top level only, 'x/' = anywhere.
excludes=(
  /bulk-youtube-download/
  /local-image-llm/
  node_modules/ .venv/ venv/ .terraform/ dist/ .astro/ .next/ .cache/
  __pycache__/ .pytest_cache/ .ruff_cache/ .mypy_cache/
  '*.iso' .DS_Store
)
# Secret-bearing names: kept out of the plaintext mirror, archived encrypted below.
# Matched case-insensitively (.ENV, KEY.PEM). A name that turns out to be a directory goes
# into the archive whole, so nothing it holds is dropped from both copies.
secret_names=(
  '*.tfstate' '*.tfstate.*' '*.tfvars' '*.tfvars.json' '*.tfplan' tfplan plan.out
  '.env*' '*.env' values.env '*.dev.vars' .dev.vars '*.envrc'
  '*.pem' '*.key' '*.p12' '*.pfx' '*.p8' '*.ppk' '*.jks' '*.keystore'
  'id_rsa*' 'id_dsa*' 'id_ecdsa*' 'id_ed25519*'
  '*keys.txt' '*.kubeconfig' 'kubeconfig*' '*-k3s.yaml' '*-k3s.yml' '*k8s-config*'
  '*-key.json' '*_key.json' '*serviceaccount*.json' '*service-account*.json'
  '*service_account*.json' sa.json
  'token*.json' 'token*.pickle' 'client_secret*.json' 'credentials*' '*secrets*'
  .git-credentials .netrc .npmrc .pypirc .pgpass .htpasswd '.vault_pass*' '*vault-pass*'
  '*.local.zsh' '*.local.symlink' 'gitconfig.local*'
  settings.local.json .mcp.json '*.age' '*.gpg' '*.asc'
)
# 'ab' -> '[aA][bB]': rsync patterns are case-sensitive. Portable to macOS bash 3.2.
nocase() {
  local p="$1" out="" c lo up i
  for (( i = 0; i < ${#p}; i++ )); do
    c="${p:i:1}"
    lo=$(printf %s "$c" | tr '[:upper:]' '[:lower:]'); up=$(printf %s "$c" | tr '[:lower:]' '[:upper:]')
    if [[ "$lo" != "$up" ]]; then out+="[$lo$up]"; else out+="$c"; fi
  done
  printf %s "$out"
}
args=(--exclude .git/)
for e in "${excludes[@]}"; do args+=(--exclude "$e"); done
for e in "${secret_names[@]}"; do args+=(--exclude "$(nocase "$e")"); done

# The same bulk folders as find(1) prune rules, and the secret names as -iname tests.
bulk=()
for e in "${excludes[@]}"; do
  case "$e" in
    /*/) bulk+=(-o -path "./${e:1:${#e}-2}") ;;
    */)  bulk+=(-o -name "${e%/}") ;;
  esac
done
named=()
for e in "${secret_names[@]}"; do named+=(-o -iname "$e"); done
named=( \( "${named[@]:1}" \) )

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# Every list below is NUL-separated, relative to ~/dev, so any legal file name survives.
strip() { local p; while IFS= read -r -d '' p; do printf '%s\0' "${p#./}"; done; }
git_safe=(git -c safe.bareRepository=explicit -c core.fsmonitor=false)

(cd "$src" && find . \( -name .git "${bulk[@]}" \) -prune -o "${named[@]}" -prune -print0) | strip > "$work/named"
(cd "$src" && find . -name .git -type d -prune -print0 -o \( -false "${bulk[@]}" \) -prune) | strip > "$work/repos"

: > "$work/ignored"; : > "$work/gitcfg"; : > "$work/rules"
while IFS= read -r -d '' g; do
  r="${g%/.git}"
  [[ -f "$src$g/config" ]] && printf '%s\0' "$g/config" >> "$work/gitcfg"
  # Gitignored files outside ignored directories, up to 1 MiB: never plaintext, always archived.
  while IFS= read -r -d '' f; do
    [[ "$f" == */ ]] && continue
    p="$r/$f"
    [[ -f "$src$p" && ! -L "$src$p" ]] || continue
    (( $(stat -f %z "$src$p") <= 1048576 )) || continue
    printf '%s\0' "$p" >> "$work/ignored"
    q="${p//\*/\\*}"; q="${q//\?/\\?}"; q="${q//\[/\\[}"
    printf -- '- /%s\0' "$q" >> "$work/rules"
  done < <("${git_safe[@]}" -C "$src$r" ls-files -z --others --ignored --exclude-standard --directory 2>/dev/null || true)
done < "$work/repos"

keys="$HOME/.config/sops/age/keys.txt"
recipient=$(sed -n 's/^# public key: //p' "$keys" 2>/dev/null | head -1)
age=$(command -v age || echo /opt/homebrew/bin/age)

if [[ ${#dry[@]} -gt 0 ]]; then
  :
elif [[ -z "$recipient" ]]; then
  echo "$(date -u +%FT%TZ) no age public key in $keys; secret files and git history not archived" >&2
  status=3
else
  # The encrypted archive first, so a file newly kept out of the mirror is never in neither copy.
  cat "$work/named" "$work/ignored" "$work/gitcfg" | sort -zu > "$work/list"
  n=$(tr -cd '\0' < "$work/list" | wc -c | tr -d ' ')
  tmp="$root/.dev-secrets.tar.age.tmp"; hist="$root/secrets-history"
  mkdir -p "$hist"
  if (( n == 0 )); then
    echo "$(date -u +%FT%TZ) no secret files found; keeping the previous archive" >&2
    status=4
  elif tar --null -cf - -C "$src" -T "$work/list" | "$age" -r "$recipient" -o "$tmp" \
      && mv -f "$tmp" "$root/dev-secrets.tar.age" \
      && cp -f "$root/dev-secrets.tar.age" "$hist/dev-secrets-$(date +%F).tar.age"; then
    echo "$(date -u +%FT%TZ) archived $n secret files (encrypted)"
    # Keep two weeks of generations: one bad night must not leave only a bad archive.
    ls -1t "$hist"/dev-secrets-*.tar.age 2>/dev/null | tail -n +15 | while IFS= read -r old; do rm -f "$old"; done
  else
    rm -f "$tmp"
    echo "$(date -u +%FT%TZ) secret archive failed" >&2
    status=4
  fi

  # Git history as encrypted bundles, rebuilt only when a repo's refs changed.
  mkdir -p "$root/git"
  built=0
  while IFS= read -r -d '' g; do
    r="${g%/.git}"; name="${r//\//__}"
    refs=$("${git_safe[@]}" -C "$src$r" for-each-ref --format='%(objectname) %(refname)' 2>/dev/null || true)
    [[ -n "$refs" ]] || continue
    sum=$(printf '%s\n' "$refs" | shasum -a 256 | cut -d' ' -f1)
    [[ -f "$root/git/$name.bundle.age" && "$(cat "$root/git/$name.refs" 2>/dev/null)" == "$sum" ]] && continue
    if "${git_safe[@]}" -C "$src$r" bundle create -q "$work/b.bundle" --all 2>/dev/null \
        && "$age" -r "$recipient" -o "$root/git/.$name.tmp" "$work/b.bundle" \
        && mv -f "$root/git/.$name.tmp" "$root/git/$name.bundle.age"; then
      printf '%s\n' "$sum" > "$root/git/$name.refs"
      built=$((built + 1))
    else
      rm -f "$root/git/.$name.tmp"
      echo "$(date -u +%FT%TZ) git bundle failed for $r" >&2
      [[ $status -eq 0 ]] && status=5
    fi
    rm -f "$work/b.bundle"
  done < "$work/repos"
  echo "$(date -u +%FT%TZ) rebuilt $built git bundle(s) (encrypted)"
fi

# --delete-excluded also removes .git directories and secret files an older run mirrored.
/usr/bin/rsync -a --delete --delete-excluded "${dry[@]}" "${args[@]}" \
  --from0 --exclude-from="$work/rules" "$src" "$dst" || { s=$?; [[ $status -eq 0 ]] && status=$s; }

finish

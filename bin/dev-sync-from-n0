#!/usr/bin/env bash
#
# The MacBook phones home: keep ~/dev on the laptop in step with n0 (the Mac Mini, always on,
# always on the mesh) so the laptop can run the homelab when n0 cannot (sublevel ADR-069,
# ADR-071). The laptop is the initiator because it is the machine that sleeps and travels.
#
# What moves, and from where:
#   - git repos: GitHub is the hub (ADR-071). Every repo under ~/dev on n0 (the list n0 computes
#     with --repos) is cloned here if missing, from its GitHub `origin` (ssh; n0's https URL is
#     rewritten) or from n0 when it has no origin, and then bin/dev-pull fast-forwards every
#     clean checkout from origin. n0 is the fallback: a repo with no origin, or whose origin
#     fetch failed (GitHub down, hotel network), is fast-forwarded from `n0/<branch>` instead.
#     A checkout with edits, or diverged, is fetched only and reported; nothing here is ever
#     reset. One that has not been able to fast-forward for a day fails the run (dev-pull "stuck").
#     Work done on the laptop goes back the way git does it: commit, push, and n0's own
#     dev-pull picks it up within 20 minutes.
#   - private files: what git does not hold (OpenTofu state, tfvars, .env, keys, gitignored
#     config), the set lib/dev-tree.sh picks for the iCloud archive minus tracked files, by
#     rsync with --update: a file newer on this side is never overwritten, it is reported
#     instead. bin/dev-push-to-n0 carries such files back to n0 (by hand, when home from a trip).
#     Two local OpenTofu states are the hazard: apply from one machine at a time.
#   - rendered here, not copied: ~/.ssh/sublevel.conf (sublevel scripts/ssh-config.sh, when the
#     inventory or pinned host keys changed) and ~/.kube/turingpi.yaml (once, from tp1).
#   - not here: ~/.ssh keys and ~/.config/sops (per-device keys, sublevel ADR-018/ADR-069),
#     Homebrew (sublevel scripts/bootstrap-mac.sh), LaunchAgents (install-launchd.sh scopes
#     them per host), and the repos in SYNC_SKIP below (n0-only by decision).
# The run ends with a heartbeat to the Uptime Kuma PUSH monitor `macbook-sync`, relayed through
# n0 because the laptop cannot reach the lab VLAN from outside the house; silence for three
# days or a failed run is a warning (not a page) via On Fire.
#
# Modes (the last three run ON n0, called over ssh by the sync and by dev-push-to-n0):
#   dev-sync-from-n0 [-n]               sync; -n = fetch and report only: no clone, merge, copy or heartbeat
#   dev-sync-from-n0 --repos            NUL-separated <path>\0<origin url>\0 pairs for every repo
#   dev-sync-from-n0 --manifest         NUL-separated private-file paths (named + gitignored)
#   dev-sync-from-n0 --heartbeat up|down <seconds>   message on stdin; pushes to Kuma
# Run by macos/com.broots.dev-sync-from-n0.plist on the MacBook: at login and every 20 minutes.
# Exit: 0 ok or n0 unreachable (skipped), 2 wrong host, 3 a repo step failed, 4 rsync failed.

set -uo pipefail

dev="$HOME/dev"
state="$HOME/.local/state/dev-sync-from-n0"
sublevel="${SUBLEVEL_DIR:-$HOME/dev/workshop144/sublevel}"
kuma_url="${KUMA_URL:-https://192.168.10.20:3443}"
export PATH="/opt/homebrew/bin:$PATH"
. "${ZSH:-$HOME/.dotfiles}/lib/dev-tree.sh"

# Repos that live on n0 only (operator decision 2026-10-14): not listed, not copied either way.
SYNC_SKIP=(nightshift)
sync_skipped() { local r="$1" s; for s in "${SYNC_SKIP[@]}"; do [[ "$r" == "$s" || "$r" == "$s"/* ]] && return 0; done; return 1; }

say() { echo "$(date -u +%FT%TZ) $*"; }
ssh_n0=(ssh -o BatchMode=yes -o ConnectTimeout=10 n0)
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"
export GIT_TERMINAL_PROMPT=0

# --- modes that run on n0 -------------------------------------------------------------------
case "${1:-}" in
  --repos)
    work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
    dev_tree_repos "$dev/" "$work/repos"
    while IFS= read -r -d '' g; do
      r="${g%/.git}"
      sync_skipped "$r" && continue
      printf '%s\0%s\0' "$r" "$("${DEV_TREE_GIT[@]}" -C "$dev/$r" config --get remote.origin.url 2>/dev/null || true)"
    done < "$work/repos"
    exit 0 ;;
  --manifest)
    work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
    dev_tree_lists "$dev/" "$work"
    dev_tree_private_files "$dev/" "$work" | while IFS= read -r -d '' p; do
      sync_skipped "$p" || printf '%s\0' "$p"
    done
    exit 0 ;;
  --heartbeat)
    status="${2:?up|down}"; seconds="${3:-0}"; msg=$(cat)
    export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
    token=$(sops -d --extract '["kuma_push_tokens"]["macbook-sync"]' "$sublevel/secrets/monitoring.enc.yaml") || exit 1
    curl -fsS -m 10 --cacert "$sublevel/stacks/qnap-monitoring/tls/tls.crt" -o /dev/null -G \
      --data-urlencode "status=$status" --data-urlencode "msg=$msg" --data-urlencode "ping=$seconds" \
      "$kuma_url/api/push/$token"
    exit $? ;;
esac

# --- the sync, on the MacBook ---------------------------------------------------------------
# Everything below is one function, so bash has parsed the whole file before it runs: the run
# pulls the dotfiles repo, which may replace this very file on disk while it executes.
main() {
dry=0; [[ "${1:-}" == "-n" ]] && dry=1
me=$(scutil --get HostName 2>/dev/null || scutil --get LocalHostName 2>/dev/null || hostname -s)
if [[ "$me" == "n0" ]]; then
  say "this is n0; the sync runs on the laptop (macos/install-launchd.sh scopes the agent)" >&2
  exit 2
fi
mkdir -p "$state" "$dev"

# One run at a time: a first clone can outlast the 20-minute interval.
if ! mkdir "$state/lock" 2>/dev/null; then
  pid=$(cat "$state/lock/pid" 2>/dev/null || true)
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then say "another run (pid $pid) is active; skipped"; exit 0; fi
  rm -rf "$state/lock"; mkdir "$state/lock" || exit 1
fi
echo $$ > "$state/lock/pid"
work=$(mktemp -d)
trap 'rm -rf "$work" "$state/lock"' EXIT

if ! "${ssh_n0[@]}" true 2>/dev/null; then
  say "n0 unreachable; skipped"
  exit 0
fi

start=$(date +%s)
status=0
pull_summary="dev-pull: not run"
repos_cloned=0; repos_n0ff=0; repos_failed=0
files_updated=0; files_newer=0
problems=()

finish() {
  local secs=$(( $(date +%s) - start )) st=up
  (( status == 0 )) || st=down
  local msg="$pull_summary; n0: $repos_cloned cloned, $repos_n0ff ff (fallback), $repos_failed failed; files: $files_updated updated, $files_newer newer here; ${secs}s"
  if (( dry == 0 )); then
    printf '{"finished_at":"%s","seconds":%d,"exit":%d,"status":"%s","summary":"%s"}\n' \
      "$(date -u +%FT%TZ)" "$secs" "$status" "$st" "$msg" > "$state/last.json"
    if ! printf '%s' "$msg" | "${ssh_n0[@]}" ".dotfiles/bin/dev-sync-from-n0 --heartbeat $st $secs"; then
      say "heartbeat to Kuma via n0 failed" >&2
    fi
  fi
  say "dev-sync-from-n0 exit=$status $msg"
  (( ${#problems[@]} == 0 )) || printf '  %s\n' "${problems[@]}"
  exit "$status"
}

# Keep the laptop's copy of this script and lib current before anything else.
(( dry )) || git -C "${ZSH:-$HOME/.dotfiles}" pull -q --ff-only 2>/dev/null || say "dotfiles pull skipped"

# --- repos: clone what is missing ------------------------------------------------------------
"${ssh_n0[@]}" .dotfiles/bin/dev-sync-from-n0 --repos > "$work/repos" || { say "could not list repos on n0" >&2; status=3; finish; }
# Repos nested inside another repo (vendored checkouts) belong to their parent's clone.
tr '\0' '\n' < "$work/repos" | awk 'NR % 2 == 1' | sort > "$work/repo-paths"
is_nested() { local p="$1" q; while IFS= read -r q; do [[ "$p" == "$q"/* ]] && return 0; done < "$work/repo-paths"; return 1; }
# The laptop authenticates to GitHub with its ssh key (ssh.github.com:443 in ~/.ssh/config);
# n0 holds https URLs and a keychain token the laptop does not have.
ssh_url() { printf '%s' "$1" | sed -E 's#^https://github\.com/#git@github.com:#'; }

while IFS= read -r -d '' r && IFS= read -r -d '' origin; do
  is_nested "$r" && continue
  dst="$dev/$r"
  if [[ ! -d "$dst/.git" ]]; then
    if (( dry )); then say "would clone $r"; repos_cloned=$((repos_cloned + 1)); continue; fi
    if [[ -n "$origin" ]] && "${DEV_TREE_GIT[@]}" clone -q "$(ssh_url "$origin")" "$dst" 2>>"$work/err"; then
      "${DEV_TREE_GIT[@]}" -C "$dst" remote add n0 "n0:dev/$r"
      say "cloned $r from origin"; repos_cloned=$((repos_cloned + 1))
    elif "${DEV_TREE_GIT[@]}" clone -q --origin n0 "n0:dev/$r" "$dst" 2>>"$work/err"; then
      [[ -n "$origin" ]] && "${DEV_TREE_GIT[@]}" -C "$dst" remote add origin "$(ssh_url "$origin")"
      say "cloned $r from n0"; repos_cloned=$((repos_cloned + 1))
    else
      problems+=("clone failed: $r ($(tail -1 "$work/err" 2>/dev/null))"); repos_failed=$((repos_failed + 1)); status=3
      continue
    fi
    "${DEV_TREE_GIT[@]}" -C "$dst" config remote.pushDefault origin
    b=$("${DEV_TREE_GIT[@]}" -C "$dst" symbolic-ref --short -q HEAD || true)
    if [[ -n "$b" && -n "$origin" ]]; then
      "${DEV_TREE_GIT[@]}" -C "$dst" config "branch.$b.remote" origin
      "${DEV_TREE_GIT[@]}" -C "$dst" config "branch.$b.merge" "refs/heads/$b"
    fi
    continue
  fi
  g=("${DEV_TREE_GIT[@]}" -C "$dst")
  "${g[@]}" remote get-url n0 >/dev/null 2>&1 || "${g[@]}" remote add n0 "n0:dev/$r"
  if [[ -n "$origin" ]] && ! "${g[@]}" remote get-url origin >/dev/null 2>&1; then
    "${g[@]}" remote add origin "$(ssh_url "$origin")"
  fi
done < "$work/repos"

# --- repos: fast-forward from GitHub, n0 as fallback ------------------------------------------
pull_args=(-q); (( dry )) && pull_args+=(-n)
"${ZSH:-$HOME/.dotfiles}/bin/dev-pull" "${pull_args[@]}" > "$work/pull.out" 2>&1
pull_summary=$(grep -o 'dev-pull: .*' "$work/pull.out" | tail -1)
[[ -n "$pull_summary" ]] || { pull_summary="dev-pull: no summary"; status=3; }
# A checkout that has been unable to fast-forward for a day fails the run (Kuma macbook-sync
# down, a warning): book's sublevel sat 85 commits behind for four days with every run green.
[[ "$pull_summary" =~ \ ([1-9][0-9]*)\ stuck ]] && status=3
while IFS= read -r line; do problems+=("${line#  }"); done < <(grep '^  ' "$work/pull.out" || true)

# A repo without origin, or whose origin fetch failed, follows n0 instead.
while IFS= read -r -d '' r && IFS= read -r -d '' origin; do
  is_nested "$r" && continue
  dst="$dev/$r"; [[ -d "$dst/.git" ]] || continue
  g=("${DEV_TREE_GIT[@]}" -C "$dst")
  res=$(awk -F '\t' -v r="$r" '$1 == r {print $2}' "$HOME/.local/state/dev-pull/results" 2>/dev/null)
  [[ "$res" == "no-origin" || "$res" == "failed" ]] || continue
  if ! "${g[@]}" fetch -q --prune n0 2>>"$work/err"; then
    problems+=("fetch from n0 failed: $r ($(tail -1 "$work/err" 2>/dev/null))"); repos_failed=$((repos_failed + 1)); status=3; continue
  fi
  b=$("${g[@]}" symbolic-ref --short -q HEAD || true)
  [[ -n "$b" ]] || continue
  [[ -z "$("${g[@]}" status --porcelain --untracked-files=no 2>/dev/null)" ]] || continue
  "${g[@]}" rev-parse -q --verify "refs/remotes/n0/$b" >/dev/null || { problems+=("branch $b not on n0, fetch only: $r"); continue; }
  n=$("${g[@]}" rev-list --count "HEAD..n0/$b" 2>/dev/null || echo 0)
  [[ "$n" == "0" ]] && continue
  if (( dry )); then say "would fast-forward $r from n0 ($n commits)"; repos_n0ff=$((repos_n0ff + 1)); continue; fi
  if "${g[@]}" merge -q --ff-only "n0/$b" 2>>"$work/err"; then
    say "fast-forwarded $r from n0 ($n commits)"; repos_n0ff=$((repos_n0ff + 1))
  elif grep -q 'untracked working tree files would be overwritten' "$work/err"; then
    problems+=("untracked files block fast-forward from n0/$b: $r")
  else
    problems+=("diverged from n0/$b, fetch only: $r")
  fi
done < "$work/repos"

# --- private files --------------------------------------------------------------------------
"${ssh_n0[@]}" .dotfiles/bin/dev-sync-from-n0 --manifest > "$work/manifest" || { say "could not list private files on n0" >&2; status=4; finish; }
# Only into repos that exist here (a failed clone must not leave a stray .env in an empty dir).
: > "$work/list"
while IFS= read -r -d '' p; do
  keep=1
  while IFS= read -r q; do
    if [[ "$p" == "$q"/* ]]; then [[ -d "$dev/$q/.git" ]] || keep=0; break; fi
  done < "$work/repo-paths"
  (( keep )) && printf '%s\0' "$p"
done < "$work/manifest" > "$work/list"
n_list=$(tr -cd '\0' < "$work/list" | wc -c | tr -d ' ')

rs=(/usr/bin/rsync -a -r -0 --files-from="$work/list" --out-format=%n -e "ssh -o BatchMode=yes -o ConnectTimeout=10")
# Dry run without --update lists every file n0 has changed; the real run with --update skips
# the ones newer here. The difference is what diverged on this side (dev-push-to-n0 carries it back).
/usr/bin/rsync -n "${rs[@]:1}" n0:dev/ "$dev/" > "$work/would" 2>>"$work/err" || true
if (( dry )); then
  cp "$work/would" "$work/did"
else
  "${rs[@]}" -u n0:dev/ "$dev/" > "$work/did" 2>>"$work/err" || { status=4; problems+=("rsync failed: $(tail -1 "$work/err" 2>/dev/null)"); }
fi
grep -v '/$' "$work/did" > "$work/did-files" || true
grep -v '/$' "$work/would" > "$work/would-files" || true
files_updated=$(grep -c . "$work/did-files" || true)
while IFS= read -r f; do
  [[ -n "$f" ]] || continue
  problems+=("newer here than on n0, kept: $f"); files_newer=$((files_newer + 1))
done < <(grep -vxF -f "$work/did-files" "$work/would-files" || true)
say "private files: $n_list listed, $files_updated updated"
(( files_newer == 0 )) || say "$files_newer file(s) newer here: run dev-push-to-n0 -n to see them, dev-push-to-n0 to carry them to n0"

# --- sublevel access files (ADR-069): rendered here, from the synced repo -----------------------
# ~/.ssh/sublevel.conf follows the inventory and the pinned host keys (re-rendered when either is
# newer); the Turing Pi kubeconfig is fetched once from tp1 over the laptop's own key.
if (( ! dry )) && [[ -d "$sublevel/.git" ]]; then
  [[ -f "$HOME/.ssh/book" ]] && export SUBLEVEL_ADMIN_KEY="${SUBLEVEL_ADMIN_KEY:-$HOME/.ssh/book}"
  conf="$HOME/.ssh/sublevel.conf"
  if [[ ! -f "$conf" || "$sublevel/ansible/inventory.yml" -nt "$conf" || "$sublevel/ansible/known_hosts" -nt "$conf" ]]; then
    if "$sublevel/scripts/ssh-config.sh" > "$work/sshcfg" 2>&1; then
      say "ssh-config: $(tail -1 "$work/sshcfg")"
    else
      problems+=("ssh-config failed: $(tail -1 "$work/sshcfg")"); status=3
    fi
  fi
  kc="$HOME/.kube/turingpi.yaml"
  if [[ ! -f "$kc" ]]; then
    if (cd "$sublevel" && just turingpi --tags kubeconfig) > "$work/kc" 2>&1; then
      say "kubeconfig: wrote $kc"
    else
      problems+=("Turing Pi kubeconfig not fetched: $(grep -m1 -E 'fatal|ERROR|error' "$work/kc")")
    fi
  fi
fi

finish
}

main "$@"

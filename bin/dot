#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	echo "  -p, --push    Syncs Brewfile and then commits and pushes dotfiles to Github repo"
	echo "  -s, --sync    Syncs Brewfile with brew-bundle dump"
	exit
}

syncBrewfile() {
	echo "Syncing Brewfile with brew-bundle..."
	dump="$(mktemp -d)"
	brew bundle dump --file="$dump/Brewfile"
	mv -f "$dotfilesDirectory/Brewfile" "$dotfilesDirectory/Brewfile-backup"
	mv -f "$dump/Brewfile" "$dotfilesDirectory/Brewfile"
	rmdir "$dump"
	echo "Done"
}

pushToGithub() {
	syncBrewfile
	current_dir=$PWD
	cd "$dotfilesDirectory"
	echo "Committing and pushing to Github"
	git checkout master
	git pull
	# Tracked files only: a new untracked file (a key, a .env) never goes to the public repo
	# unless it was added by hand first.
	git add -u
	# Tracked *.symlink files are the live ~/.gitconfig, ~/.gemrc, ...: whatever a tool writes
	# with `git config --global` or `gem sources` lands in them. Those go out only after a look.
	if ! git diff --cached --quiet -- '*.symlink'; then
		git --no-pager diff --cached -- '*.symlink'
		if [ -t 0 ] && printf 'Publish these live-config changes to the public repo? [y/N] ' && read -r ans && [ "$ans" = y ]; then
			:
		else
			git restore --staged -- '*.symlink'
			echo "Live-config (*.symlink) changes left unstaged; review and commit them by hand" >&2
		fi
	fi
	# Credential-shaped additions never reach the public repo unattended.
	if git diff --cached -U0 | grep '^+' | grep -qiE 'extraheader|authorization:|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_|glpat-|xox[abpr]-|AKIA[0-9A-Z]{16}|://[^/@ ]+:[^/@ ]+@|PRIVATE KEY'; then
		git reset -q
		echo "Staged changes look like they carry a credential; nothing committed or pushed" >&2
		exit 1
	fi
	if git diff --cached --quiet; then
		echo "Nothing to commit"
	else
		git commit -m "Auto sync and push"
	fi
	# Publish only what this run committed; older unpushed commits wait for a human.
	ahead="$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
	if [ "$ahead" -gt 1 ]; then
		git --no-pager log --oneline '@{u}..HEAD'
		if [ -t 0 ] && printf 'Push these %s commits to the public repo? [y/N] ' "$ahead" && read -r ans && [ "$ans" = y ]; then
			git push
		else
			echo "Not pushed ($ahead commits ahead); push by hand after review" >&2
		fi
	elif [ "$ahead" -eq 1 ]; then
		git push
	fi
	untracked="$(git ls-files --others --exclude-standard)"
	[ -n "$untracked" ] && printf 'Not pushed (untracked; git add them first if intended):\n%s\n' "$untracked"
	echo "Done"
	cd "$current_dir"
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		"-s"|"--sync")
			syncBrewfile
			exit
			;;
		"-p"|"--push")
			pushToGithub
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH=$HOME/.dotfiles

# Set macOS defaults
$ZSH/macos/set-defaults.sh

# Install homebrew
$ZSH/homebrew/install.sh 2>&1

# Upgrade homebrew
echo "› brew update"
brew update

# Install software
echo "› $ZSH/script/install"
$ZSH/script/install

# Install/refresh LaunchAgents (e.g. the periodic Brewfile reconciler)
echo "› $ZSH/macos/install-launchd.sh"
$ZSH/macos/install-launchd.sh

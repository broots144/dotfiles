#!/bin/bash
# Gate for P8 (herdr on n0): pinned version, Claude integration, server under launchd,
# socket answering, socket and directory modes. Run on n0: `just verify-phase-8`.
set -u
cd "$(dirname "$0")/.." || exit 1
bad=0
# This output is pasted into STATE.md of a public repo: paths print as ~/..., owners as
# "me"/"other" (never a name), and the account name is masked anyway as a backstop.
ME="$(id -un)"; UID_ME="$(id -u)"
HERDR_DIR="${HERDR_DIR:-$HOME/.config/herdr}"
say()  { local m="$*"; m="${m//$HOME/~}"; echo "${m//$ME/<user>}"; }
# Nothing but say() reaches the transcript: no command's stderr (paths, names) gets through.
exec 2>/dev/null
owner() { [[ "$1" == "$UID_ME" ]] && echo me || echo other; }
ok()   { say "ok   $*"; }
nope() { say "FAIL $*"; bad=1; }

pin="$(cat herdr/VERSION)"
BIN="${HERDR_BIN:-/opt/homebrew/bin/herdr}"  # the binary the LaunchAgent runs, not whatever PATH finds
have="$("$BIN" --version | awk '{print $2}')"
[[ "$have" == "$pin" ]] && ok "herdr $have at the LaunchAgent's path (pin herdr/VERSION $pin)" || nope "herdr '$have' is not the pin $pin"
[[ ! -e "$HOME/.local/bin/herdr" ]] && ok "no herdr in ~/.local/bin (remote-attach install path)" \
  || nope "a herdr binary sits in ~/.local/bin and can shadow the pinned one"
brew list --pinned 2>/dev/null | grep -qx herdr && ok "brew pin herdr" || nope "herdr is not brew-pinned"

line="$(herdr integration status 2>/dev/null | grep '^claude:')"
[[ "$line" == "claude: current"* ]] && ok "integration $line" || nope "integration: '$line'"
hook="$HOME/.claude/hooks/herdr-agent-state.sh"
n="$(grep -c "herdr-agent-state.sh' session" "$HOME/.claude/settings.json" 2>/dev/null || true)"
[[ "$n" == 1 && -r "$hook" ]] && ok "settings.json has 1 herdr SessionStart hook; hook sha256 $(shasum -a 256 "$hook" | cut -c1-16)" \
  || nope "settings.json has $n herdr hook entries"

grep -q '^HERDR_ACTION=.* python3 -I - <<' "$hook" && ok "Claude hook runs python3 -I (no cwd on sys.path)" \
  || nope "Claude hook runs python3 without -I (run herdr/install.sh)"

label=com.broots.herdr-server
state="$(launchctl print "gui/$(id -u)/$label" 2>/dev/null | awk -F'= ' '/^\tstate =/{print $2; exit}')"
[[ "$state" == running ]] && ok "launchd $label: running" || nope "launchd $label: '${state:-not loaded}'"

status="$(herdr status server)"
served="$(awk -F': *' '/^ *version:/{print $2; exit}' <<<"$status")"
grep -q '^ *status: running' <<<"$status" && ok "server running" || nope "server: $(head -1 <<<"$status")"
[[ "$served" == "$pin" ]] && ok "running server is the pin ($served)" \
  || nope "running server is '${served:-?}', not the pin $pin (restart it: launchctl kickstart -k)"
reply="$(herdr workspace list 2>/dev/null)"
[[ "$reply" == *'"type":"workspace_list"'* ]] && ok "API socket answers (workspace.list)" || nope "API socket: no workspace_list reply"

dir="$HERDR_DIR"
read -r mode uid <<<"$(stat -f '%Lp %u' "$dir" 2>/dev/null)"
[[ "$mode $uid" == "700 $UID_ME" ]] && ok "$dir mode 700, owner me" || nope "$dir is mode ${mode:-?}, owner $(owner "${uid:-}")"
for s in herdr.sock herdr-client.sock; do
  if [[ -S "$dir/$s" ]]; then kind=socket; else kind=not-a-socket; fi
  read -r mode uid <<<"$(stat -f '%Lp %u' "$dir/$s" 2>/dev/null)"
  [[ "$kind $mode $uid" == "socket 600 $UID_ME" ]] && ok "$s: socket 600, owner me" \
    || nope "$s: $kind, mode ${mode:-?}, owner $(owner "${uid:-}")"
done
[[ "$(readlink "$dir/config.toml")" == "$HOME/.dotfiles/herdr/config.toml" ]] && ok "config.toml linked to dotfiles" \
  || nope "config.toml is not the dotfiles link"
herdr config check >/dev/null 2>&1 && ok "herdr config check" || nope "herdr config check"
man="$(herdr server agent-manifests 2>/dev/null)"
if [[ -n "$man" ]] && ! awk 'NR>3 && NF {print $2}' <<<"$man" | grep -qv '^bundled$' && grep -q '^last check: never' <<<"$man"; then
  ok "agent-detection rules: all bundled with the pinned binary, never checked remotely (D-012)"
else
  nope "agent-detection rules not all bundled, or a remote check ran: $(head -1 <<<"$man")"
fi

(( bad )) && { echo "verify-phase-8 FAILED"; exit 1; }
echo "verify-phase-8 ok"
